{%- assign desktop_image = section.settings.image -%}
{%- assign mobile_image = section.settings.mobile_image | default: desktop_image -%}

<div class="about-hero-banner">
  <div class="about-hero-banner__media">
    {%- if desktop_image != blank -%}
      {{
        desktop_image
        | image_url: width: 2200
        | image_tag:
          class: 'about-hero-banner__image about-hero-banner__image--desktop',
          loading: 'eager',
          widths: '1100, 1500, 1800, 2200',
          sizes: '100vw',
          alt: desktop_image.alt
      }}
    {%- endif -%}

    {%- if mobile_image != blank -%}
      {{
        mobile_image
        | image_url: width: 1200
        | image_tag:
          class: 'about-hero-banner__image about-hero-banner__image--mobile',
          loading: 'eager',
          widths: '600, 800, 1000, 1200',
          sizes: '100vw',
          alt: mobile_image.alt
      }}
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
  }

  #shopify-section-{{ section.id }} .about-hero-banner {
    width: 100%;
    min-height: 50vh;
    background: #f7f1e8;
  }

  #shopify-section-{{ section.id }} .about-hero-banner__media {
    position: relative;
    width: 100%;
    min-height: 50vh;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .about-hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #shopify-section-{{ section.id }} .about-hero-banner__image--desktop {
    display: block;
  }

  #shopify-section-{{ section.id }} .about-hero-banner__image--mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .about-hero-banner,
    #shopify-section-{{ section.id }} .about-hero-banner__media {
      min-height: 400px;
      height: 60vh;
    }

    #shopify-section-{{ section.id }} .about-hero-banner__image--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .about-hero-banner__image--mobile {
      display: block;
    }
  }
</style>

{% schema %}
{
  "name": "About Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    }
  ],
  "presets": [
    {
      "name": "About Hero Banner"
    }
  ]
}
{% endschema %}

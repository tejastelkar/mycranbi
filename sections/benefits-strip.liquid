{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .benefits-strip {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .benefits-strip__heading {
    text-align: center;
    color: {{ section.settings.text_color }};
    margin-top: 0;
    margin-bottom: 5rem;
    font-family: var(--font-heading-family);
    font-weight: 400;
    letter-spacing: 0.06em;
    font-size: clamp(2.6rem, 3.2vw, 3.6rem);
  }

  .benefits-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .benefits-strip__grid {
      grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
      gap: 4rem;
    }
  }

  .benefit-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem;
  }

  .benefit-item__icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefit-item__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
  }

  .benefit-item__content {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .benefit-item__title {
    font-size: 1.2rem;
    font-family: var(--font-body-family);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .benefit-item__text {
    font-size: 1.5rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  .benefit-item__text p {
    margin: 0;
  }
{%- endstyle -%}

<div class="benefits-strip section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="benefits-strip__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="benefits-strip__grid">
      {%- for block in section.blocks -%}
        <div class="benefit-item" {{ block.shopify_attributes }}>
          <div class="benefit-item__icon">
            {%- if block.settings.custom_svg != blank -%}
              {{ block.settings.custom_svg }}
            {%- else -%}
              {%- assign benefit_title = block.settings.title | downcase -%}
              {%- if benefit_title contains 'gift-ready' or benefit_title contains 'gift ready' -%}
                <svg viewBox="0 0 48 48" aria-hidden="true">
                  <rect x="8" y="18" width="32" height="20" rx="1"></rect>
                  <path d="M24 18v20"></path>
                  <path d="M8 26h32"></path>
                  <path d="M18 18c-3 0-5-2-5-4.5S14.8 9 18 9c3.9 0 6 5.2 6 9"></path>
                  <path d="M30 18c3 0 5-2 5-4.5S33.2 9 30 9c-3.9 0-6 5.2-6 9"></path>
                </svg>
              {%- elsif benefit_title contains 'premium' or benefit_title contains 'self-care' or benefit_title contains 'self care' -%}
                <svg viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M24 39s-10-6.6-10-17a6 6 0 0 1 10-4.3A6 6 0 0 1 34 22c0 10.4-10 17-10 17Z"></path>
                  <path d="M19 24c1.8-1.4 3.4-2.1 5-2.1 1.8 0 3.3.7 5 2.1"></path>
                </svg>
              {%- elsif benefit_title contains 'mix your own box' or benefit_title contains 'mix' -%}
                <svg viewBox="0 0 48 48" aria-hidden="true">
                  <rect x="9" y="10" width="30" height="28" rx="1"></rect>
                  <path d="M24 10v28"></path>
                  <path d="M9 24h30"></path>
                  <path d="M17 17h0"></path>
                  <path d="M31 31h0"></path>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M24 9l4.6 9.4 10.4 1.5-7.5 7.3 1.8 10.3L24 32.8l-9.3 4.9 1.8-10.3-7.5-7.3 10.4-1.5Z"></path>
                </svg>
              {%- endif -%}
            {%- endif -%}
          </div>
          
          <div class="benefit-item__content">
            {%- if block.settings.title != blank -%}
              <h3 class="benefit-item__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="benefit-item__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefits Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your permanent benefits"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#660033"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Icon",
          "info": "Paste SVG code here"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Free delivery"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>over €39*</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Strip",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}

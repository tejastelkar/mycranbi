    "craft": {
      "type": "image-with-text",
      "settings": {
        "height": "medium",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "content_layout": "no-overlap",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-2",
        "color_scheme": "scheme-2",
        "padding_top": 52,
        "padding_bottom": 52
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": { "heading": "Our Craft", "heading_size": "h1" }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Every MY CRANBI product is thoughtfully created using carefully selected ingredients, inspired by the timeless wisdom of Ayurveda and designed for modern lifestyles. Free from sulphates, parabens, silicones, and formaldehyde — made with care, made in India.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": ["heading", "text"]
    },
    "commitments": {
      "type": "commitment-pillars",
      "settings": {
        "title": "OUR COMMITMENTS",
        "heading_size": "h1",
        "background_color": "#FFFFFF",
        "padding_top": 80,
        "padding_bottom": 80
      },
      "blocks": {
        "pillar-1": {
          "type": "pillar",
          "settings": {
            "title": "Free From Harsh Chemicals",
            "text": "<p>Our formulas are made without sulphates, parabens, silicones, or formaldehyde and artificial colours — many are vegan too, so you know exactly what's going on your skin and hair.</p>"
          }
        },
        "pillar-2": {
          "type": "pillar",
          "settings": {
            "title": "Rooted in Real Saffron",
            "text": "<p>Sourced through our family's own MAA KESAR saffron venture in Srinagar, pure Kashmir saffron is at the heart of many MY CRANBI formulas.</p>"
          }
        },
        "pillar-3": {
          "type": "pillar",
          "settings": {
            "title": "Ayurvedic Ingredients, Modern Science",
            "text": "<p>From amla and shikakai to brahmi and hyaluronic acid, we blend traditional botanicals with proven actives for results you can feel.</p>"
          }
        },
        "pillar-4": {
          "type": "pillar",
          "settings": {
            "title": "Made with Care in India",
            "text": "<p>Every MY CRANBI product is thoughtfully created and crafted in India, turning everyday routines into moments of luxurious self-care.</p>"
          }
        }
      },
      "block_order": ["pillar-1", "pillar-2", "pillar-3", "pillar-4"]
    },
    "values": {
      "type": "brand-story",
      "settings": {
        "title": "OUR VALUES",
        "heading_size": "h1",
        "background_color": "#FFF9F2",
        "padding_top": 80,
        "padding_bottom": 80
      },
      "blocks": {
        "value-1": {
          "type": "column",
          "settings": {
            "title": "Purity",
            "text": "<p>Honest formulations, free from sulphates, parabens, silicones, and formaldehyde — so every product is exactly what it claims to be.</p>"
          }
        },
        "value-2": {
          "type": "column",
          "settings": {
            "title": "Compassion",
            "text": "<p>A family business built on trust, integrity, and service since 1985 — carried forward with the same care in every bottle.</p>"
          }
        },
        "value-3": {
          "type": "column",
          "settings": {
            "title": "Conscious Care",
            "text": "<p>From our own saffron fields in Srinagar to your daily ritual, every product is thoughtfully crafted to enrich everyday life.</p>"
          }
        }
      },
      "block_order": ["value-1", "value-2", "value-3"]
